# Copier en .env et renseigner. En production, ces valeurs viennent d'Azure Key Vault.

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Base de données
DATABASE_URL=postgresql+psycopg://prreview:prreview@localhost:5432/prreview

# JWT applicatifs (générer une valeur aléatoire forte en prod)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Microsoft Entra ID (laisser vide pour utiliser uniquement le repli local)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Repli auth locale (comptes de service / tests)
ENABLE_LOCAL_AUTH=true
